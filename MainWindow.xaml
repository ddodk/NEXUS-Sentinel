
<Window x:Class="NEXUS.Sentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Sentinel"
        Width="1180" Height="800"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#11151D" Foreground="#E5EAF2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A202B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3544"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5EAF2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A5B0C0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7299D4"/>

        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#222B39"/>
            <Setter Property="Foreground" Value="#E5EAF2"/>
            <Setter Property="BorderBrush" Value="#303B4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#151B25"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#354153"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#8BB4ED"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#202937"/>
            <Setter Property="Foreground" Value="#C9D5E5"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#303B4B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#1A202B"/>
            <Setter Property="Foreground" Value="#DDE5F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252F3E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30445E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="NEXUS SENTINEL"
                           FontSize="27"
                           FontWeight="Bold"/>
                <TextBlock Text="Мониторинг и анализ процессов Windows"
                           FontSize="13"
                           Foreground="#A5B0C0"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#202B39"
                    BorderBrush="#35465A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#C5D5E7"/>
            </Border>
        </Grid>

        <!-- Состояние мониторинга -->
        <Border Grid.Row="1"
                Style="{StaticResource SectionCard}"
                Padding="15"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="СОСТОЯНИЕ МОНИТОРИНГА"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#A5B0C0"/>
                <TextBlock x:Name="StatusText"
                           Text="Подготовка мониторинга..."
                           FontSize="14"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Поиск и действия -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterBox"
                     Grid.Column="0"
                     Height="40"
                     VerticalContentAlignment="Center"
                     ToolTip="Поиск по имени процесса, PID или пути"
                     TextChanged="FilterBox_TextChanged"/>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Click="RefreshButton_Click"
                    Style="{StaticResource ActionButton}"
                    Background="#304A6B"/>

            <Button Grid.Column="2"
                    Content="Сбросить"
                    Click="ClearFilterButton_Click"
                    Style="{StaticResource ActionButton}"/>

            <Button Grid.Column="3"
                    Content="Журнал"
                    Click="OpenEventLogButton_Click"
                    Style="{StaticResource ActionButton}"/>
        </Grid>

        <!-- Сканирование файлов -->
        <Border Grid.Row="3"
                Style="{StaticResource SectionCard}"
                Padding="15"
                Margin="0,0,0,14">

            <StackPanel>
                <TextBlock Text="СКАНИРОВАНИЕ ФАЙЛОВ"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#A9B9FF"/>

                <TextBlock Text="Вычисление SHA-256 локально на компьютере"
                           FontSize="12"
                           Foreground="#A5B0C0"
                           Margin="0,4,0,12"/>

                <WrapPanel>
                    <Button x:Name="ScanFileButton"
                            Content="Выбрать файл и вычислить SHA-256"
                            Click="ScanFileButton_Click"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,8,8"
                            Background="#304A6B"/>

                    <Button x:Name="CopyHashButton"
                            Content="Копировать хеш"
                            Click="CopyHashButton_Click"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,0,8"
                            IsEnabled="False"/>
                </WrapPanel>

                <TextBlock Text="Файл"
                           FontSize="11"
                           Foreground="#A5B0C0"
                           Margin="0,4,0,4"/>

                <TextBox x:Name="ScanFilePathText"
                         IsReadOnly="True"
                         Text="Файл не выбран"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"/>

                <TextBlock Text="SHA-256"
                           FontSize="11"
                           Foreground="#A5B0C0"
                           Margin="0,0,0,4"/>

                <TextBox x:Name="Sha256Text"
                         IsReadOnly="True"
                         Text="Хеш ещё не вычислен"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Margin="0,0,0,8"/>

                <TextBlock x:Name="ScanResultText"
                           Text="Ожидание выбора файла."
                           Foreground="#A5B0C0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>

        <!-- Таблица процессов -->
        <Border Grid.Row="4"
                Background="#1A202B"
                BorderBrush="#2B3544"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

            <DataGrid x:Name="ProcessGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2B3544"
                      Background="#1A202B"
                      Foreground="#DDE5F0"
                      BorderThickness="0"
                      AlternatingRowBackground="#1D2531"
                      FontSize="12"
                      RowHeight="38"
                      ColumnHeaderHeight="40"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Процесс"
                                        Binding="{Binding ProcessName}"
                                        Width="170"/>
                    <DataGridTextColumn Header="PID"
                                        Binding="{Binding Id}"
                                        Width="70"/>
                    <DataGridTextColumn Header="CPU"
                                        Binding="{Binding CpuText}"
                                        Width="85"/>
                    <DataGridTextColumn Header="Память"
                                        Binding="{Binding MemoryText}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Путь к файлу"
                                        Binding="{Binding PathText}"
                                        Width="*"
                                        MinWidth="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Нижняя строка -->
        <Grid Grid.Row="5" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="NEXUS Sentinel • Локальный сбор данных"
                       FontSize="11"
                       Foreground="#8996A8"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Column="1"
                       Text="Windows • .NET 8"
                       FontSize="11"
                       Foreground="#8996A8"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</Window>
