
<Window x:Class="NEXUS.Sentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Sentinel"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#11151D"
        Foreground="#E5EAF2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#11151D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A202B"/>
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#222B39"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2B3544"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5EAF2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A5B0C0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7299D4"/>

        <Style x:Key="ActionButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#222B39"/>
            <Setter Property="Foreground" Value="#E5EAF2"/>
            <Setter Property="BorderBrush" Value="#303B4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303D50"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#506580"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#263448"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#151B25"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#354153"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#8BB4ED"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#7299D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#202937"/>
            <Setter Property="Foreground" Value="#C9D5E5"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderBrush" Value="#303B4B"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="#1A202B"/>
            <Setter Property="Foreground" Value="#DDE5F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252F3E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#30445E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="NEXUS SENTINEL"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#E5EAF2"
                           CharacterSpacing="50"/>

                <TextBlock Text="Мониторинг и анализ процессов Windows"
                           FontSize="14"
                           Foreground="#A5B0C0"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#202B39"
                    BorderBrush="#35465A"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="#82B5A0"
                             VerticalAlignment="Center"
                             Margin="0,0,9,0"/>
                    <TextBlock Text="ЛОКАЛЬНЫЙ РЕЖИМ"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#C5D5E7"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Monitoring status -->
        <Border Grid.Row="1"
                Style="{StaticResource SectionCard}"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="#27384D"
                        VerticalAlignment="Center">
                    <TextBlock Text="●"
                               Foreground="#8BB4ED"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="СОСТОЯНИЕ МОНИТОРИНГА"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#A5B0C0"/>

                    <TextBlock x:Name="StatusText"
                               Text="Подготовка мониторинга..."
                               FontSize="15"
                               Foreground="#E5EAF2"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search and actions -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterBox"
                     Grid.Column="0"
                     Height="42"
                     ToolTip="Поиск по имени процесса, PID или пути"
                     TextChanged="FilterBox_TextChanged"/>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Click="RefreshButton_Click"
                    Style="{StaticResource ActionButton}"
                    Background="#304A6B"
                    BorderBrush="#405E83"/>

            <Button Grid.Column="2"
                    Content="Сбросить"
                    Click="ClearFilterButton_Click"
                    Style="{StaticResource ActionButton}"/>

            <Button Grid.Column="3"
                    Content="Журнал событий"
                    Click="OpenEventLogButton_Click"
                    Style="{StaticResource ActionButton}"/>
        </Grid>

        <!-- Process table -->
        <Border Grid.Row="3"
                Background="#1A202B"
                BorderBrush="#2B3544"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

            <DataGrid x:Name="ProcessGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2B3544"
                      VerticalGridLinesBrush="#242D3A"
                      Background="#1A202B"
                      Foreground="#DDE5F0"
                      BorderThickness="0"
                      RowBackground="#1A202B"
                      AlternatingRowBackground="#1D2531"
                      FontSize="13"
                      RowHeight="42"
                      ColumnHeaderHeight="44"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}"
                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"/>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Процесс"
                                        Binding="{Binding ProcessName}"
                                        Width="190"/>

                    <DataGridTextColumn Header="PID"
                                        Binding="{Binding Id}"
                                        Width="85"/>

                    <DataGridTextColumn Header="CPU"
                                        Binding="{Binding CpuText}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Память"
                                        Binding="{Binding MemoryText}"
                                        Width="115"/>

                    <DataGridTextColumn Header="Путь к файлу"
                                        Binding="{Binding PathText}"
                                        Width="*"
                                        MinWidth="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="2,13,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="NEXUS Sentinel  •  Локальный сбор данных"
                       FontSize="11"
                       Foreground="#8996A8"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Column="1"
                       Text="Windows  •  .NET 8"
                       FontSize="11"
                       Foreground="#8996A8"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</Window>
