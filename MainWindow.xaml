
<Window x:Class="NEXUS.Sentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Sentinel"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#090D18"
        Foreground="#F0F3FF">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="NEXUS SENTINEL"
                       FontSize="27"
                       FontWeight="Bold"/>
            <TextBlock Text="SENTINEL WATCH  /  WINDOWS PROCESS MONITOR"
                       Foreground="#9AA8C2"
                       FontSize="11"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#151C2D"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="МОНИТОРИНГ ПРОЦЕССОВ"
                           FontSize="12"
                           Foreground="#9AA8C2"/>
                <TextBlock x:Name="StatusText"
                           Text="Подготовка списка процессов..."
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,7,0,4"/>
                <TextBlock Text="Данные обновляются автоматически. Отсутствие предупреждений не означает, что система гарантированно безопасна."
                           TextWrapping="Wrap"
                           Foreground="#9AA8C2"
                           FontSize="11"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterBox"
                     Grid.Column="0"
                     Height="38"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     Background="#151C2D"
                     Foreground="#F0F3FF"
                     BorderBrush="#303A50"
                     CaretBrush="#8175FF"
                     FontSize="13"
                     ToolTip="Поиск по имени процесса, PID или пути"
                     TextChanged="FilterBox_TextChanged"/>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Click="RefreshButton_Click"
                    Margin="10,0,0,0"
                    Padding="16,8"
                    Background="#8175FF"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>

            <Button Grid.Column="2"
                    Content="Сбросить поиск"
                    Click="ClearFilterButton_Click"
                    Margin="8,0,0,0"
                    Padding="12,8"
                    Background="#252E43"
                    Foreground="#F0F3FF"
                    BorderThickness="0"/>
        </Grid>

        <DataGrid x:Name="ProcessGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#283247"
                  Background="#101727"
                  Foreground="#F0F3FF"
                  BorderBrush="#283247"
                  RowBackground="#101727"
                  AlternatingRowBackground="#151C2D"
                  FontSize="12"
                  RowHeight="34"
                  ColumnHeaderHeight="38"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="True">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#202A3E"/>
                    <Setter Property="Foreground" Value="#DDE4F5"/>
                    <Setter Property="Padding" Value="9,8"/>
                    <Setter Property="BorderBrush" Value="#303A50"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Процесс"
                                    Binding="{Binding ProcessName}"
                                    Width="1.2*"/>

                <DataGridTextColumn Header="PID"
                                    Binding="{Binding Id}"
                                    Width="65"/>

                <DataGridTextColumn Header="CPU"
                                    Binding="{Binding CpuText}"
                                    Width="85"/>

                <DataGridTextColumn Header="RAM"
                                    Binding="{Binding MemoryText}"
                                    Width="100"/>

                <DataGridTextColumn Header="Путь к файлу"
                                    Binding="{Binding PathText}"
                                    Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4"
                   Text="CPU — оценка по интервалу между обновлениями. Путь может быть недоступен без дополнительных разрешений."
                   Foreground="#9AA8C2"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
