
<Window x:Class="NEXUS.Sentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Sentinel"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#080B12"
        Foreground="#F2F5FF">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#252D43"/>
            <Setter Property="Foreground" Value="#F2F5FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="NEXUS SENTINEL"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#F2F5FF"/>

                <TextBlock Text="Локальный мониторинг процессов Windows"
                           FontSize="13"
                           Foreground="#96A3BB"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Статус мониторинга -->
        <Border Grid.Row="1"
                Background="#151C2D"
                BorderBrush="#28344B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,18">

            <StackPanel>
                <TextBlock Text="СОСТОЯНИЕ МОНИТОРИНГА"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#96A3BB"/>

                <TextBlock x:Name="StatusText"
                           Text="Подготовка мониторинга..."
                           FontSize="15"
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Поиск и кнопки -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterBox"
                     Grid.Column="0"
                     Height="38"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     Background="#151C2D"
                     Foreground="#F2F5FF"
                     BorderBrush="#303A50"
                     CaretBrush="#8175FF"
                     ToolTip="Поиск по имени, PID или пути"
                     TextChanged="FilterBox_TextChanged"/>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Click="RefreshButton_Click"
                    Style="{StaticResource ActionButton}"
                    Background="#776BFF"/>

            <Button Grid.Column="2"
                    Content="Сбросить поиск"
                    Click="ClearFilterButton_Click"
                    Style="{StaticResource ActionButton}"/>

            <Button Grid.Column="3"
                    Content="Журнал событий"
                    Click="OpenEventLogButton_Click"
                    Style="{StaticResource ActionButton}"/>
        </Grid>

        <!-- Таблица процессов -->
        <Border Grid.Row="3"
                Background="#101727"
                BorderBrush="#283247"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">

            <DataGrid x:Name="ProcessGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#283247"
                      VerticalGridLinesBrush="#202A3E"
                      Background="#101727"
                      Foreground="#F2F5FF"
                      BorderThickness="0"
                      RowBackground="#101727"
                      AlternatingRowBackground="#151C2D"
                      FontSize="12"
                      RowHeight="34"
                      ColumnHeaderHeight="38">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#202A3E"/>
                        <Setter Property="Foreground" Value="#DDE4F5"/>
                        <Setter Property="Padding" Value="9,8"/>
                        <Setter Property="BorderBrush" Value="#303A50"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Процесс"
                                        Binding="{Binding ProcessName}"
                                        Width="180"/>

                    <DataGridTextColumn Header="PID"
                                        Binding="{Binding Id}"
                                        Width="80"/>

                    <DataGridTextColumn Header="CPU"
                                        Binding="{Binding CpuText}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Память"
                                        Binding="{Binding MemoryText}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Путь к файлу"
                                        Binding="{Binding PathText}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Нижняя подпись -->
        <TextBlock Grid.Row="4"
                   Text="NEXUS Sentinel • Локальный сбор данных • Доступ к некоторым процессам может быть ограничен Windows"
                   FontSize="10"
                   Foreground="#7F8CA5"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
