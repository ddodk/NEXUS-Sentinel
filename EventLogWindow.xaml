
<Window x:Class="NEXUS.Sentinel.EventLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS Sentinel — Журнал событий"
        Width="1000"
        Height="650"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#090D18"
        Foreground="#F0F3FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ЖУРНАЛ СОБЫТИЙ"
                       FontSize="24"
                       FontWeight="Bold"/>
            <TextBlock Text="Локальная история NEXUS Sentinel"
                       Foreground="#9AA8C2"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="38"
                     Padding="10,8"
                     VerticalContentAlignment="Center"
                     Background="#151C2D"
                     Foreground="#F0F3FF"
                     BorderBrush="#303A50"
                     CaretBrush="#8175FF"
                     ToolTip="Поиск по типу, PID или описанию"
                     TextChanged="SearchBox_TextChanged"/>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Click="RefreshButton_Click"
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Background="#8175FF"
                    Foreground="White"
                    BorderThickness="0"/>

            <Button Grid.Column="2"
                    Content="Экспорт JSON"
                    Click="ExportButton_Click"
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Background="#252E43"
                    Foreground="#F0F3FF"
                    BorderThickness="0"/>
        </Grid>

        <DataGrid x:Name="EventsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#283247"
                  Background="#101727"
                  Foreground="#F0F3FF"
                  BorderBrush="#283247"
                  RowBackground="#101727"
                  AlternatingRowBackground="#151C2D"
                  FontSize="12"
                  RowHeight="34"
                  ColumnHeaderHeight="38">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#202A3E"/>
                    <Setter Property="Foreground" Value="#DDE4F5"/>
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="BorderBrush" Value="#303A50"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Время UTC"
                                    Binding="{Binding TimestampText}"
                                    Width="155"/>

                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding Type}"
                                    Width="175"/>

                <DataGridTextColumn Header="PID"
                                    Binding="{Binding ProcessIdText}"
                                    Width="70"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Message}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="CountText"
                   Grid.Row="3"
                   Text="Записей: 0"
                   Foreground="#9AA8C2"
                   FontSize="11"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
